# Production settings; `docker/prod.sh init` copies this to $LOFU_PROD_DIR/.env.
# Generate with: openssl rand -base64 32
MEILI_MASTER_KEY=
# Absolute path for SQLite, article archives, backups and the search index.
LOFU_DATA=
# Tailscale sidecar (docker/compose.tailscale.yaml): lofu gets its own tailnet
# node, https://<TS_HOSTNAME>.<tailnet>.ts.net, proxying to 127.0.0.1:${LOFU_HTTP_PORT}.
# The auth key (https://login.tailscale.com/admin/settings/keys) is only used for
# the first login; you can delete it from this file afterwards.
TS_HOSTNAME=lofu
TS_AUTHKEY=
# Optional sidecar ports (must not collide with host tailscaled or other sidecars).
# TS_WG_PORT=41644
# TS_HEALTH_PORT=41235
# Loopback ports on the host, apart from the development stack's 8787/7700.
LOFU_HTTP_PORT=8788
MEILI_HTTP_PORT=7701
# Optional: where `docker/prod.sh backup` copies each snapshot off this disk.
# A directory (a mounted NAS) or an rsync target such as nas:/backups/lofu.
LOFU_BACKUP_COPY_TO=
