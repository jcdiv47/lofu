# Server
LOFU_PORT=8787
LOFU_HOST=127.0.0.1
LOFU_DATA_DIR=./data
# Number of extraction worker threads (default: min(4, cores - 1))
# LOFU_EXTRACT_WORKERS=4
# Max concurrent page fetches
# LOFU_FETCH_CONCURRENCY=8
# Set to 0 to disable trying HTTP/2 first for https pages
# LOFU_FETCH_HTTP2=1
# Minimum gap between requests to the same host (politeness for bulk imports)
# LOFU_FETCH_HOST_INTERVAL_MS=1000
# Headless-Chromium fallback for JS-only pages and some bot checks:
#   auto (default: launch a local Chromium on demand), off, or a CDP URL (http://host:9222)
# LOFU_BROWSER=auto
# LOFU_CHROME_PATH=/usr/bin/chromium
# LOFU_CHROME_ARGS=--no-sandbox

# Meilisearch
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=change-me-to-a-long-random-string
