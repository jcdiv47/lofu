{
  "name": "lofu",
  "id": "app.lofu.reader",
  "version": "1.0.0",
  "build": 1,
  "rust": ".",
  "icon": "../../design/logo/logo.png",
  "capabilities": {
    "network": { "hosts": ["*"] },
    "webview": { "hosts": ["*"] },
    "application": true,
    "clipboard": true,
    "statusBar": true,
    "openUrl": { "schemes": ["http", "https"] },
    "fs": {
      "read": [
        "${dataDir}",
        "${homeDir}/.local/share/app.lofu.reader",
        "${homeDir}/Library/Application Support/app.lofu.reader"
      ]
    },
    "host": ["lofu.secret.read", "lofu.secret.write", "lofu.share", "lofu.keyboard.keepAway"]
  },
  "window": {
    "titleBar": {
      "style": "hidden",
      "height": 52
    },
    "minSize": {
      "width": 800,
      "height": 480
    }
  }
}
