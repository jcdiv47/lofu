{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/target",
      "!**/data",
      "!.agents",
      "!.claude",
      "!.hermes",
      "!skills-lock.json",
      "!**/*.md",
      "!**/.output",
      "!**/.wxt",
      "!**/.nsh",
      "!apps/reader/e2e/apps/target.ts",
      "!apps/reader/e2e/apps/library.test.tsx"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    }
  ]
}
