{
  "name": "lofu",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/server/src/main.ts",
    "start": "bun apps/server/src/main.ts",
    "test": "bun test",
    "typecheck": "tsc -b && bun run --cwd apps/extension typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "cli:build": "cargo build --release -p lofu-cli",
    "services:up": "docker compose -f docker/compose.yaml up -d meilisearch",
    "stack:up": "mkdir -p data/server data/meili && docker compose -f docker/compose.yaml up -d --build",
    "stack:down": "docker compose -f docker/compose.yaml down",
    "stack:token": "docker compose -f docker/compose.yaml exec server bun src/admin.ts token",
    "ext:build": "bun run --cwd apps/extension build && bun run --cwd apps/extension build:firefox",
    "ext:e2e": "bun run --cwd apps/extension e2e",
    "reader:web": "nsh run apps/reader/App.tsx --target web",
    "reader:test": "cd apps/reader && nsh check && nsh test",
    "reader:android": "bun apps/reader/android/package.ts",
    "reader:android:test": "bun apps/reader/android/package.ts --test && bun apps/reader/android/device.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
